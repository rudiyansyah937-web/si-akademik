{
  "info": {
    "name": "RESTful API Mahasiswa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost/setoran/acara_16/api" }
  ],
  "item": [
    {
      "name": "1. GET semua mahasiswa",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/mahasiswa" } }
    },
    {
      "name": "2. GET mahasiswa berdasarkan ID",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/mahasiswa/1" } }
    },
    {
      "name": "3. POST tambah mahasiswa",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23004\",\n  \"nama\": \"Dewi\",\n  \"email\": \"dewi@gmail.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa" }
      }
    },
    {
      "name": "4. PUT ubah mahasiswa",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23001\",\n  \"nama\": \"Budi Santoso\",\n  \"email\": \"budi.santoso@gmail.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa/1" }
      }
    },
    {
      "name": "5. DELETE hapus mahasiswa",
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/mahasiswa/4" } }
    },
    {
      "name": "ERROR - ID tidak ditemukan (404)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/mahasiswa/999" } }
    },
    {
      "name": "ERROR - ID bukan angka (400)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/mahasiswa/abc" } }
    },
    {
      "name": "ERROR - NIM kosong (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"\",\n  \"nama\": \"Dewi\",\n  \"email\": \"dewi@gmail.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa" }
      }
    },
    {
      "name": "ERROR - Email tidak valid (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23005\",\n  \"nama\": \"Rani\",\n  \"email\": \"rani\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa" }
      }
    },
    {
      "name": "ERROR - Data JSON tidak lengkap (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23006\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa" }
      }
    },
    {
      "name": "ERROR - NIM sudah terdaftar (409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23001\",\n  \"nama\": \"Duplikat\",\n  \"email\": \"duplikat@gmail.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa" }
      }
    },
    {
      "name": "ERROR - PUT ID tidak ditemukan (404)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23999\",\n  \"nama\": \"Tidak Ada\",\n  \"email\": \"tidakada@gmail.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/mahasiswa/999" }
      }
    }
  ]
}